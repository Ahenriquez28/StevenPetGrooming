# Copy to .env — defaults work for local dev out of the box.
# See docs/DOCKER-DEPLOY.md and docs/EMAIL.md for what each does.

POSTGRES_PASSWORD=luxepups_dev

# 32+ random characters in production (rotating it logs everyone out)
JWT__SECRET=dev_only_secret_change_me_0123456789abcdef

# First-boot password for the seeded owner account (ahenriquez200528@gmail.com).
# Only applies when the admin row doesn't exist yet. CHANGE IN PRODUCTION.
ADMIN_SEED_PASSWORD=LuxePups2026!

# SMTP — dev defaults point at Mailpit (http://localhost:8025 to view caught mail).
# For production values see docs/EMAIL.md.
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__User=
Smtp__Password=
Smtp__UseStartTls=false
Smtp__FromAddress=noreply@luxepupsutah.com
Smtp__FromName=Luxe Pups Grooming
Smtp__OwnerNotificationEmail=ahenriquez200528@gmail.com

Cors__Origins=https://luxepupsutah.com,http://localhost:5173
